# ============ ERP System Environment Configuration ============
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit the real `.env` file to version control.

# --- Django ---
# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (PostgreSQL) ---
# Replace these with YOUR OWN database credentials. Never commit real credentials.
DB_NAME=erp
DB_USER=postgres
DB_PASSWORD=change-me-to-your-real-password
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Cache & Message Broker) ---
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Security (set True in production) ---
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
X_FRAME_OPTIONS=DENY
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- API / Rate limiting ---
LOGIN_THROTTLE_RATE=10/min
ANON_THROTTLE_RATE=100/min
USER_THROTTLE_RATE=1000/hour

# --- Web login brute-force protection ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Email Configuration ---
# Console backend for development, SMTP for production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@erpsystem.com

# --- CORS Configuration ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
